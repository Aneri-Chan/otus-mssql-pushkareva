@model List<MyDatabase.Models.Book>

<h2>Результаты поиска</h2>

@if (!Model.Any())
{
    <p>@ViewBag.Message</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Название</th>
                <th>Автор</th>
                <th>Цена</th>
                <th>ISBN</th>
                <th>Дата поступления</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.BookName</td>
                    <td>@book.Author</td>
                    <td>@book.Price руб.</td>
                    <td>@book.ISBN</td>
                    <td>@(book.DateInput?.ToString("dd.MM.yyyy") ?? "Не указано")</td>
                </tr>
            }
        </tbody>
    </table>
}
