@model IEnumerable<MyDatabase.Models.BookViewModel>

<h2>Книги в данной категории</h2>

<div class="view-toggle">
    <button onclick="showListView()">Список</button>
    <button onclick="showTableView()">Таблица</button>
    <button onclick="showCardView()">Карточки</button>
</div>

<div id="bookContainer"></div>

<script>
    let books = @Html.Raw(Json.Serialize(Model));

    function renderBooks(viewType) {
        let bookContainer = document.getElementById("bookContainer");
        bookContainer.innerHTML = "";

        if (viewType === "list") {
            books.forEach(book => {
                let div = document.createElement("div");
                div.classList.add("list-item");
                div.innerHTML = `
                    <img src="../media/${book.photoLink}" class="book-image" />
                    <div class="book-info">
                        <h3>${book.bookName}</h3>
                        <button class="save-btn">Отложить</button>
                    </div>
                    <div class="book-purchase">
                        <p>${book.price} руб.</p>
                        <div class="qty-container">
                            <input type="number" min="1" value="1" class="qty-input" />
                            <button class="cart-btn">В корзину</button>
                        </div>
                    </div>
                `;
                bookContainer.appendChild(div);
            });
        }
        else if (viewType === "table") {
            let table = document.createElement("table");
            table.classList.add("book-table");
            table.innerHTML = `<tr><th>Обложка</th><th>Название</th><th>Цена</th><th></th></tr>`;
            books.forEach(book => {
                let row = `<tr>
                    <td><img src="../media/${book.photoLink}" class="book-thumbnail" /></td>
                    <td>${book.bookName}</td>
                    <td>${book.price} руб.</td>
                    <td><a href="/Book/BookDetails/${book.bookID}" class="details-btn">Подробнее</a></td>
                </tr>`;
                table.innerHTML += row;
            });
            bookContainer.appendChild(table);
        }
        else if (viewType === "card") {
            books.forEach(book => {
                let card = document.createElement("div");
                card.classList.add("card");
                card.innerHTML = `
                    <a href="/Book/BookDetails/${book.bookID}" class="card-link">
                        <img src="../media/${book.photoLink}" class="book-image" />
                        <h3>${book.bookName}</h3>
                        <p>${book.price} руб.</p>
                    </a>
                `;
                bookContainer.appendChild(card);
            });
        }
    }

    function showListView() { renderBooks("list"); }
    function showTableView() { renderBooks("table"); }
    function showCardView() { renderBooks("card"); }

    showCardView();
</script>

<style>
    .book-table {
        border-collapse: collapse;
        width: 100%;
    }

        .book-table th, .book-table td {
            border: 1px solid black;
            padding: 8px;
        }

    .book-thumbnail {
        width: 50px;
        height: 70px;
    }

    .card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        width: 200px;
        height: 300px;
        border: 1px solid #ccc;
        border-radius: 10px;
        padding: 10px;
        margin: 10px;
        text-align: center;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
        background-color: #fff;
        overflow: hidden;
    }

        .card img {
            width: 100%;
            height: 150px;
            object-fit: cover;
            border-radius: 5px;
        }

        .card h3 {
            font-size: 16px;
            font-weight: bold;
            margin: 5px 0;
        }

        .card a {
            text-decoration: none;
            color: black;
        }

        .card p {
            font-size: 14px;
            color: #333;
            margin: 5px 0;
        }

    #bookContainer {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
    }

    .book-image {
        width: 100%;
        height: auto;
    }

    .list-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 15px;
        border-bottom: 1px solid #ccc;
        width: 100%;
        max-width: 800px;
        background: #f9f9f9;
        border-radius: 5px;
    }

        .list-item img {
            width: 80px;
            height: 100px;
            object-fit: cover;
            border-radius: 5px;
        }

    .book-info {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        text-align: left;
    }

        .book-info h3 {
            font-size: 16px;
            margin: 0;
        }

    .save-btn {
        background: #f39c12;
        color: white;
        border: none;
        padding: 5px 10px;
        cursor: pointer;
        border-radius: 5px;
        font-size: 14px;
        width: fit-content;
        align-self: flex-start;
    }

    .cart-btn {
        background: #007bff;
        color: white;
        border: none;
        padding: 5px 10px;
        cursor: pointer;
        border-radius: 5px;
        font-size: 14px;
    }
</style>
