@model MyDatabase.Models.Book
@using MyDatabase.Models
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Добавление книги";
    Layout = "_Layout";
}

<h2 class="mt-3">➕ Добавление книги</h2>

<!-- Сообщение об ошибке -->
<div id="bookAlert" class="text-center mb-3"></div>

<form id="bookForm" enctype="multipart/form-data" class="p-3 border rounded container mb-5" style="max-width: 600px;">
    <input name="BookName" placeholder="Название книги" class="form-control mb-2" required />
    <span data-valmsg-for="BookName" class="text-danger mb-2 d-block"></span>

    <input name="Author" placeholder="Автор" class="form-control mb-2" required />
    <span data-valmsg-for="Author" class="text-danger mb-2 d-block"></span>

    <input name="Price" placeholder="Цена" type="number" step="0.01" class="form-control mb-2" required />
    <span data-valmsg-for="Price" class="text-danger mb-2 d-block"></span>

    <input name="Weight" placeholder="Вес (г)" type="number" class="form-control mb-2" />
    <span data-valmsg-for="Weight" class="text-danger mb-2 d-block"></span>

    <input name="ISBN" placeholder="ISBN" class="form-control mb-2" pattern="[A-Za-z0-9\-]*" />
    <span data-valmsg-for="ISBN" class="text-danger mb-2 d-block"></span>

    <select name="CategoryID" class="form-select mb-2" required>
        <option disabled selected value="">-- Выберите категорию --</option>
        @foreach (var cat in ViewBag.Categories as List<Category>)
        {
            <option value="@cat.CategoryID">@cat.CategoryName</option>
        }
    </select>
    <span data-valmsg-for="CategoryID" class="text-danger mb-2 d-block"></span>

    <textarea name="Description" rows="4" placeholder="Описание" class="form-control mb-2" required></textarea>
    <span data-valmsg-for="Description" class="text-danger mb-2 d-block"></span>

    <div class="form-check mb-2">
        <input type="hidden" name="New" value="false" />
        <input type="checkbox" name="New" value="true" class="form-check-input" id="newBook" />
        <label class="form-check-label" for="newBook">Новинка</label>
    </div>

    <div class="form-check mb-2">
        <input type="hidden" name="AddCategory" value="false" />
        <input type="checkbox" name="AddCategory" value="true" class="form-check-input" id="addCategory" />
        <label class="form-check-label" for="addCategory">Мы советуем</label>
    </div>

    <div class="form-check mb-3">
        <input type="hidden" name="Bestseller" value="false" />
        <input type="checkbox" name="Bestseller" value="true" class="form-check-input" id="bestseller" />
        <label class="form-check-label" for="bestseller">Хит продаж</label>
    </div>


    <div class="mb-3">
        <input type="file" name="Images" multiple accept=".jpg,.jpeg,.png" class="form-control" />
        <div class="form-text">Можно загрузить несколько изображений (jpg, png)</div>
    </div>

    <button type="submit" class="btn btn-success">💾 Сохранить</button>
    <a href="@Url.Action("Index", "Books", new { area = "Admin" })" class="btn btn-secondary">↩️ Назад</a>
</form>



@section Scripts {
    <script>
        const bookForm = document.getElementById('bookForm');
        const alertBox = document.getElementById('bookAlert');

        bookForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = new FormData(bookForm);
            alertBox.innerHTML = "";
            document.querySelectorAll("span[data-valmsg-for]").forEach(span => span.textContent = "");
                    ["New", "AddCategory", "Bestseller"].forEach(name => {
            const checkbox = bookForm.querySelector(`input[name="${name}"][type="checkbox"]`);
            formData.set(name, checkbox.checked ? "true" : "false");
        });


            try {
                const response = await fetch('@Url.Action("Create", "Books", new { area = "Admin" })', {
                    method: 'POST',
                    body: formData
                });

                const text = await response.text();
                console.log("Сервер вернул:", text);

                let result;
                try {
                    result = JSON.parse(text);
                } catch (jsonError) {
                    alertBox.innerHTML = `<div class="text-danger">Ответ сервера не в формате JSON:</div><pre>${text}</pre>`;
                    return;
                }

                if (!response.ok || !result.success) {
                    if (result.errors) {
                        for (const key in result.errors) {
                            const span = bookForm.querySelector(`span[data-valmsg-for="${key}"]`);
                            if (span) span.textContent = result.errors[key][0];
                        }
                    }
                    alertBox.innerHTML = `<div class="text-danger">${result.message || "Ошибка при сохранении книги."}</div>`;
                } else {
                    alertBox.innerHTML = `<div class="text-success">${result.message}</div>`;
                    bookForm.reset();
                }
            } catch (error) {
                console.error("Ошибка в JS:", error);
                alertBox.innerHTML = `<div class="text-danger">Ошибка на клиенте: ${error.message}</div>`;
            }
        }); 
    </script>
}

