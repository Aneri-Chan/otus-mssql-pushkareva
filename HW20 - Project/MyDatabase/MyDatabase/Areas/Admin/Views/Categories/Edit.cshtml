@model MyDatabase.Models.Category

@{
    ViewData["Title"] = "Редактирование категории";
    Layout = "_Layout";
}

<h2 class="mt-3">✏️ Редактирование категории</h2>

<div id="categoryAlert" class="text-center mb-3"></div>

<form id="categoryForm" method="post" action="@Url.Action("Edit", "Categories", new { area = "Admin" })" class="p-3 border rounded" style="max-width: 500px;">
    @Html.AntiForgeryToken()

    <input type="hidden" name="CategoryID" value="@Model.CategoryID" />

    <input type="text" name="CategoryName" value="@Model.CategoryName" placeholder="Название категории" class="form-control mb-2" required />

    <button type="submit" class="btn btn-success">💾 Сохранить</button>
    <a href="@Url.Action("Index", "Categories", new { area = "Admin" })" class="btn btn-secondary">↩️ Назад</a>
</form>

<script>
    document.getElementById("categoryForm").addEventListener("submit", async function (e) {
        e.preventDefault();

        const form = e.target;
        const formData = new FormData(form);

        try {
            const response = await fetch(form.action, {
                method: "POST",
                body: formData
            });

            const result = await response.json();

            const alertDiv = document.getElementById("categoryAlert");
            alertDiv.className = "alert";
            if (result.success) {
                alertDiv.classList.add("alert-success");
                alertDiv.textContent = result.message;
            } else {
                alertDiv.classList.add("alert-danger");
                alertDiv.textContent = result.message || "Ошибка при обновлении категории.";
            }

        } catch (error) {
            console.error("Ошибка при отправке формы:", error);
            const alertDiv = document.getElementById("categoryAlert");
            alertDiv.className = "alert alert-danger";
            alertDiv.textContent = "Произошла ошибка при отправке формы.";
        }
    });
</script>
