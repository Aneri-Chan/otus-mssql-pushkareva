@model IEnumerable<MyDatabase.Models.Category>

@{
    ViewData["Title"] = "Категории";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Категории</h2>

<a class="btn btn-primary mb-3" href="@Url.Action("Create")">Добавить категорию</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CategoryID</td>
                <td>@item.CategoryName</td>
                <td>
                    <a class="btn btn-sm btn-warning" href="@Url.Action("Edit", new { id = item.CategoryID })">Редактировать</a>
                    <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", new { id = item.CategoryID })"
                       onclick="return confirm('Удалить эту категорию?');">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>
